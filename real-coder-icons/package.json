{
  "name": "realcoder-icons",
  "displayName": "Real Coder Icons",
  "description": "Real Coder Icons — neon icon theme for VS Code with NeoObjectPascal (.npas) support. Inspired by the Material Icon Theme.",
  "version": "5.37.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean:icons": "tsx ./src/scripts/icons/cleanIcons.ts",
    "precompile": "rimraf dist && npm run clean:icons && npm run verify",
    "compile": "tsc -p ./",
    "compile:declarations": "tsc -p ./tsconfig.declarations.json",
    "postcompile": "npm run compile:declarations && npm run generateJson && npm run generateOpenFolders && npm run generateClones && npm run check",
    "build": "npm run compile && tsx ./build/build-with-esbuild.ts",
    "watch": "tsx ./build/watch-with-esbuild.ts",
    "check-colors": "tsx ./src/scripts/svg/checkSvgColors.ts",
    "check": "tsx ./src/scripts/icons/checks/run.ts",
    "contributors": "tsx ./src/scripts/contributors/contributors.ts",
    "generateJson": "tsx ./src/scripts/icons/generateJson.ts > ./dist/realcoder-icons.json",
    "generateClones": "tsx ./src/scripts/icons/generateClones.ts",
    "generateOpenFolders": "tsx ./src/scripts/svg/generateOpenFolderIcons.ts",
    "lint": "biome check",
    "markdownlint": "markdownlint '**/*.md'",
    "format": "biome format --write ./src",
    "preversion": "npm run contributors && npm run preview && npm run svgo && git add images/*.png icons/*.svg",
    "preview": "tsx ./src/scripts/preview/run.ts",
    "svgo": "svgo -i icons -o icons -q",
    "test": "vitest run",
    "vscode:prepublish": "npm run lint && npm run build",
    "verify": "sheriff verify",
    "prepublishOnly": "tsx ./src/scripts/module/prepare.ts",
    "postpublish": "git checkout package.json && git checkout README.md",
    "prepare": "husky || true"
  },
  "publisher": "alvarobrito",
  "author": {
    "name": "Álvaro Brito",
    "url": "https://github.com/neoobjectpascal"
  },
  "engines": {
    "vscode": "^1.55.0"
  },
  "homepage": "https://github.com/neoobjectpascal/vs-extensions/tree/main/real-coder-icons",
  "repository": {
    "type": "git",
    "url": "https://github.com/neoobjectpascal/vs-extensions.git",
    "directory": "real-coder-icons"
  },
  "bugs": {
    "url": "https://github.com/neoobjectpascal/vs-extensions/issues"
  },
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#0D0D0D",
    "theme": "dark"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "icons",
    "theme",
    "realcoder",
    "neon",
    "npas",
    "neoobjectpascal",
    "icon-theme",
    "customization"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension/desktop/extension.cjs",
  "browser": "./dist/extension/web/extension.cjs",
  "module": "./dist/module/index.cjs",
  "types": "./dist/types/module/index.d.ts",
  "sideEffects": false,
  "contributes": {
    "iconThemes": [
      {
        "id": "realcoder-icons",
        "label": "Real Coder Icons",
        "path": "./dist/realcoder-icons.json",
        "_watch": true
      }
    ],
    "commands": [
      {
        "command": "realcoder-icons.activateIcons",
        "title": "%command.activateIcons%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.toggleIconPacks",
        "title": "%command.toggleIconPacks%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.changeFolderTheme",
        "title": "%command.changeFolderTheme%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.changeFolderColor",
        "title": "%command.changeFolderColor%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.changeRootFolderColor",
        "title": "%command.changeRootFolderColor%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.changeFileColor",
        "title": "%command.changeFileColor%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.restoreDefaultConfig",
        "title": "%command.restoreDefaultConfig%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.toggleExplorerArrows",
        "title": "%command.toggleExplorerArrows%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.changeOpacity",
        "title": "%command.changeOpacity%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.toggleGrayscale",
        "title": "%command.toggleGrayscale%",
        "enablement": "!isWeb"
      },
      {
        "command": "realcoder-icons.changeSaturation",
        "title": "%command.changeSaturation%",
        "enablement": "!isWeb"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "realcoder-icons.activeIconPack": {
          "type": "string",
          "default": "angular",
          "description": "%configuration.activeIconPack%",
          "enumDescriptions": [
            "%configuration.activeIconPack.angular%",
            "%configuration.activeIconPack.angular_ngrx%",
            "%configuration.activeIconPack.react%",
            "%configuration.activeIconPack.react_redux%",
            "%configuration.activeIconPack.roblox%",
            "%configuration.activeIconPack.qwik%",
            "%configuration.activeIconPack.vue%",
            "%configuration.activeIconPack.vue_vuex%",
            "%configuration.activeIconPack.nest%",
            "%configuration.activeIconPack.bashly%",
            "%configuration.activeIconPack.none%"
          ],
          "enum": [
            "angular",
            "angular_ngrx",
            "react",
            "react_redux",
            "roblox",
            "qwik",
            "vue",
            "vue_vuex",
            "nest",
            "bashly",
            "none"
          ]
        },
        "realcoder-icons.files.associations": {
          "type": "object",
          "default": {},
          "description": "%configuration.files.associations%"
        },
        "realcoder-icons.folders.associations": {
          "type": "object",
          "default": {},
          "description": "%configuration.folders.associations%"
        },
        "realcoder-icons.rootFolders.associations": {
          "type": "object",
          "default": {},
          "description": "%configuration.rootFolders.associations%"
        },
        "realcoder-icons.languages.associations": {
          "type": "object",
          "default": {},
          "description": "%configuration.languages.associations%"
        },
        "realcoder-icons.files.customClones": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%configuration.customClones.name%"
              },
              "base": {
                "type": "string",
                "description": "%configuration.customClones.base%"
              },
              "color": {
                "type": "string",
                "description": "%configuration.customClones.color%"
              },
              "lightColor": {
                "type": "string",
                "description": "%configuration.customClones.lightColor%"
              },
              "fileNames": {
                "type": "array",
                "default": [],
                "description": "%configuration.customClones.fileNames%",
                "items": {
                  "type": "string"
                }
              },
              "fileExtensions": {
                "type": "array",
                "default": [],
                "description": "%configuration.customClones.fileExtensions%",
                "items": {
                  "type": "string"
                }
              },
              "activeForPacks": {
                "type": "array",
                "default": [
                  "angular"
                ],
                "description": "%configuration.customClones.activeForPacks%",
                "items": {
                  "type": "string",
                  "enumDescriptions": [
                    "%configuration.activeIconPack.angular%",
                    "%configuration.activeIconPack.angular_ngrx%",
                    "%configuration.activeIconPack.react%",
                    "%configuration.activeIconPack.react_redux%",
                    "%configuration.activeIconPack.roblox%",
                    "%configuration.activeIconPack.qwik%",
                    "%configuration.activeIconPack.vue%",
                    "%configuration.activeIconPack.vue_vuex%",
                    "%configuration.activeIconPack.nest%",
                    "%configuration.activeIconPack.bashly%",
                    "%configuration.activeIconPack.none%"
                  ],
                  "enum": [
                    "angular",
                    "angular_ngrx",
                    "react",
                    "react_redux",
                    "qwik",
                    "vue",
                    "vue_vuex",
                    "nest",
                    "bashly",
                    "none"
                  ]
                }
              }
            }
          },
          "description": "%configuration.customClones%"
        },
        "realcoder-icons.languages.customClones": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%configuration.customClones.name%"
              },
              "base": {
                "type": "string",
                "description": "%configuration.customClones.base%"
              },
              "color": {
                "type": "string",
                "description": "%configuration.customClones.color%"
              },
              "lightColor": {
                "type": "string",
                "description": "%configuration.customClones.lightColor%"
              },
              "ids": {
                "type": "array",
                "default": [],
                "description": "%configuration.customClones.ids%",
                "items": {
                  "type": "string"
                }
              },
              "activeForPacks": {
                "type": "array",
                "default": [
                  "angular"
                ],
                "description": "%configuration.customClones.activeForPacks%",
                "items": {
                  "type": "string",
                  "enumDescriptions": [
                    "%configuration.activeIconPack.angular%",
                    "%configuration.activeIconPack.angular_ngrx%",
                    "%configuration.activeIconPack.react%",
                    "%configuration.activeIconPack.react_redux%",
                    "%configuration.activeIconPack.roblox%",
                    "%configuration.activeIconPack.qwik%",
                    "%configuration.activeIconPack.vue%",
                    "%configuration.activeIconPack.vue_vuex%",
                    "%configuration.activeIconPack.nest%",
                    "%configuration.activeIconPack.bashly%",
                    "%configuration.activeIconPack.none%"
                  ],
                  "enum": [
                    "angular",
                    "angular_ngrx",
                    "react",
                    "react_redux",
                    "qwik",
                    "vue",
                    "vue_vuex",
                    "nest",
                    "bashly",
                    "none"
                  ]
                }
              }
            }
          },
          "description": "%configuration.customClones%"
        },
        "realcoder-icons.folders.customClones": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%configuration.customClones.name%"
              },
              "base": {
                "type": "string",
                "description": "%configuration.customClones.base%"
              },
              "color": {
                "type": "string",
                "description": "%configuration.customClones.color%"
              },
              "lightColor": {
                "type": "string",
                "description": "%configuration.customClones.lightColor%"
              },
              "folderNames": {
                "type": "array",
                "description": "%configuration.customClones.folderNames%",
                "items": {
                  "type": "string"
                }
              },
              "rootFolderNames": {
                "type": "array",
                "description": "%configuration.customClones.rootFolderNames%",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "description": "%configuration.customClones%"
        },
        "realcoder-icons.folders.theme": {
          "type": "string",
          "default": "specific",
          "description": "%configuration.folders.theme%",
          "enumDescriptions": [
            "%configuration.folders.theme.specific%",
            "%configuration.folders.theme.classic%",
            "%configuration.folders.theme.none%"
          ],
          "enum": [
            "specific",
            "classic",
            "none"
          ]
        },
        "realcoder-icons.folders.color": {
          "type": "string",
          "default": "#90a4ae",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "%configuration.folders.color%"
        },
        "realcoder-icons.rootFolders.color": {
          "type": "string",
          "default": "#90a4ae",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "%configuration.rootFolders.color%"
        },
        "realcoder-icons.files.color": {
          "type": "string",
          "default": "#90a4ae",
          "pattern": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$",
          "description": "%configuration.files.color%"
        },
        "realcoder-icons.opacity": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "%configuration.opacity%"
        },
        "realcoder-icons.hidesExplorerArrows": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.hidesExplorerArrows%"
        },
        "realcoder-icons.saturation": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "maximum": 1,
          "description": "%configuration.saturation%"
        },
        "realcoder-icons.enableLogging": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.enableLogging%"
        },
        "realcoder-icons.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "info",
            "error",
            "debug"
          ],
          "description": "%configuration.logLevel%"
        }
      }
    }
  },
  "dependencies": {
    "chroma-js": "^3.2.0",
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.0",
    "@commitlint/config-conventional": "^21.0.1",
    "@softarc/sheriff-core": "^0.19.6",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^26.0.0",
    "@types/vscode": "~1.55.0",
    "axios": "^1.16.1",
    "changelogen": "0.6.2",
    "cheerio": "^1.2.0",
    "commitlint": "^21.0.1",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "markdownlint-cli": "^0.49.0",
    "puppeteer": "^25.0.0",
    "rimraf": "^6.1.3",
    "svg-color-linter": "^3.0.0",
    "svgo": "^4.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "patchedDependencies": {
    "changelogen@0.6.2": "patches/changelogen@0.6.2.patch"
  }
}
